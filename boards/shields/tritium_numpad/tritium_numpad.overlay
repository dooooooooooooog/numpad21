/*
 * Tritium Numpad ZMK Shield Overlay
 * Controller: ProMicro NRF52840 (SuperMini NRF52840)
 *
 * Pin mapping (from official pinout diagram):
 *   Row 0 → pin 3  → P0.20
 *   Row 1 → pin 5  → P0.24
 *   Row 2 → pin 6  → P1.00
 *   Row 3 → pin 7  → P0.11
 *   Row 4 → pin 8  → P1.04
 *   Row 5 → pin 9  → P1.06
 *   Col 0 → A0     → P0.31
 *   Col 1 → A1     → P0.29
 *   Col 2 → A2     → P0.02
 *   Col 3 → A3     → P1.15
 *
 * diode-direction: row2col
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <6>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)
            RC(5,0)         RC(5,2) RC(5,3)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "row2col";

        row-gpios
            = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 0: pin 3  */
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 1: pin 5  */
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 2: pin 6  */
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 3: pin 7  */
            , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 4: pin 8  */
            , <&gpio1  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 5: pin 9  */
            ;

        col-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 0: A0 */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 1: A1 */
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 2: A2 */
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 3: A3 */
            ;
    };
};
