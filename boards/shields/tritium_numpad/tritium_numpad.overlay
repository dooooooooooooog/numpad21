/*
 * Tritium Numpad ZMK Shield Overlay
 * Controller: Nice!Nano (Pro Micro compatible pinout)
 *
 * Wiring (same as original Pro Micro, no changes needed):
 *   Rows: Pro Micro 3, 5, 6, 7, 8, 9
 *   Cols: Pro Micro A0, A1, A2, A3
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <6>;

        /*
         * Layout: LAYOUT_numpad_6x4
         *
         * ,-------------.
         * | CPY| PST| ( | ) |
         * | NLK| /  | * | - |
         * |  7 |  8 |  9 |   |
         * |  4 |  5 |  6 | + |
         * |  1 |  2 |  3 |   |
         * |    0    | . |ENT|
         * `-------------'
         */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)
            RC(5,0)         RC(5,2) RC(5,3)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 0 */
            , <&pro_micro 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 1 */
            , <&pro_micro 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 2 */
            , <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 3 */
            , <&pro_micro 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 4 */
            , <&pro_micro 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Row 5 */
            ;

        col-gpios
            = <&pro_micro 18 GPIO_ACTIVE_HIGH>   /* Col 0: A0 */
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>   /* Col 1: A1 */
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>   /* Col 2: A2 */
            , <&pro_micro 21 GPIO_ACTIVE_HIGH>   /* Col 3: A3 */
            ;
    };
};
